require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.1'
use_frameworks! :linkage => :static

target 'LxMusic' do
  config = use_native_modules!

  pod 'react-native-navigation', :path => '../node_modules/react-native-navigation'

  # Stub podspecs for Android-only packages (to prevent pod install failures)
  pod 'RNFileSystem', :path => 'LxMusic/Libraries'
  pod 'RNLocalMediaMetadata', :path => 'LxMusic/Libraries'

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Fix Xcode 15+ compatibility: remove -fno-objc-arc from some files
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.1'
      end
    end
  end
end
